# Bu dosyayi kopyalayip ".env" adiyla kaydet ve degerleri kendine gore doldur.
# .env dosyasi ASLA git'e girmez (bkz. .gitignore)
#
# Canlida (Render) bu degerler dosyadan degil,
# platformun "Environment Variables" ekranindan verilir.

# Sunucunun dinleyecegi port.
# Render bu degiskeni KENDISI atar; canlida elle vermene gerek yok.
PORT=4000

# PostgreSQL baglanti adresi.
# Gelistirme: yerel PostgreSQL
# Canli: Neon'un verdigi adres (sslmode=require ile)
DATABASE_URL="postgresql://postgres:SIFRE@localhost:5432/devplatform?schema=public"

# JWT imzalama anahtari. Uzun ve rastgele olmali.
# Uretmek icin: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# CANLIDA MUTLAKA FARKLI BIR DEGER KULLAN.
JWT_SECRET="buraya-uzun-ve-rastgele-bir-metin"

# Arayuzun adresi. CORS bu adrese izin verir.
# Gelistirmede bos birak (Vite proxy kullaniyoruz, CORS'a gerek yok).
# Canlida: https://senin-sitesi.onrender.com
# CLIENT_URL=

# Kayit endpoint'ini acar. VARSAYILAN KAPALI.
# Tek kisilik bir site oldugu icin canlida ASLA acilmamali.
# Yeni kullanici olusturmanin yolu: prisma/seed.ts
# ALLOW_REGISTRATION=true

# Seed ile olusturulacak admin kullanicisinin sifresi.
# Sadece "npx prisma db seed" calistirirken gerekir.
# SEED_ADMIN_PASSWORD=
