// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Yetki seviyeleri.
//
// Onceden yalnizca "gecerli token" kontrol ediliyordu; token'i olan
// HERKES yazi silebiliyordu. Guvenlik ALLOW_REGISTRATION bayraginin
// kapali olmasina asilmisti -- bayrak bir gun acilirsa kayit olan
// herkes yonetici olurdu.
//
// Rol veritabaninda durur: bir ortam degiskeninin unutulmasi
// artik yetki acigina donusmez.
enum Role {
  USER // giris yapabilir, icerige DOKUNAMAZ
  ADMIN // yazi ve proje olusturur, gunceller, siler
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  name     String?

  // Guvenli varsayilan: yeni kullanici yonetici DEGILDIR.
  // Yonetici yapmanin tek yolu seed (prisma/seed.ts).
  role Role @default(USER)

  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  content   String
  excerpt   String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Iliskinin Post tarafi.
  // author   -> kodda kullandigin kolaylik (gercek sutun DEGIL)
  // authorId -> database'de gercekten olusan foreign key sutunu
  // Simdilik opsiyonel (?), cunku henuz kullanici sistemi yok.
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?
}

model Project {
  id          Int    @id @default(autoincrement())
  title       String
  slug        String @unique
  description String

  // Uc adres de opsiyonel: her projenin gorseli, deposu
  // veya canli demosu olmak zorunda degil.
  imageUrl  String?
  githubUrl String?
  demoUrl   String?

  // Ana sayfada one cikarilacak projeler icin.
  featured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
